DATABASE_URL=postgresql://user:password@localhost:5432/smartsoil
API_PORT=8000

# Required. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=replace_me_with_32_random_bytes

# Comma-separated list of allowed origins for CORS. Use a single origin in prod.
# Defaults to "http://localhost:8080" if unset.
CORS_ORIGINS=http://localhost:8080

RESEND_API_KEY=re_your_api_key
EMAIL_FROM=RootSphere <onboarding@resend.dev>

# --- Image disease detection ---
# Primary: local multimodal model via Ollama (no API key, no internet).
# Set OLLAMA_HOST to where the ollama container is reachable. In Docker
# compose this is the service hostname; locally it's localhost.
OLLAMA_HOST=http://ollama:11434
# gemma3:4b fits in ~5GB RAM. gemma4:e2b is the upgrade target when you
# have 12GB+ allocated to Docker.
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_S=120

# Fallbacks (optional — only used if Ollama is down/unconfigured)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
